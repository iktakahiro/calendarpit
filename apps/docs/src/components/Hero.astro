---
/**
 * Starlight's `Hero`, overridden for the landing pages. It renders the `hero`
 * frontmatter as the default hero does (title, tagline, and link buttons), and
 * adds the page's `eyebrow` label and the routing diagram. The default hero
 * accepts only an image file or a raw HTML string beside the text, and the
 * diagram is a localized component.
 */
import { LinkButton } from '@astrojs/starlight/components';
import LandingDiagram from './landing/LandingDiagram.astro';
import en from './landing/diagram.en.json';
import ja from './landing/diagram.ja.json';

const diagramCopies: Partial<Record<string, typeof en>> = { ja };

const { entry, locale } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const diagramCopy = (locale && diagramCopies[locale]) || en;
// Starlight's skip link targets the page title by this id (`PAGE_TITLE_ID`),
// which the package does not export.
const pageTitleId = '_top';
---

<div class='hero-frame'>
  <div class='hero'>
    <div class='copy'>
      {data.eyebrow && <p class='eyebrow'>{data.eyebrow}</p>}
      <h1 id={pageTitleId} data-page-title set:html={title} />
      {tagline && <p class='tagline' set:html={tagline} />}
      {
        actions.length > 0 && (
          <div class='actions'>
            {actions.map(
              ({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
                <LinkButton
                  href={link}
                  {variant}
                  icon={icon?.type === 'icon' ? icon.name : undefined}
                  class:list={[className]}
                  {...attrs}
                >
                  {text}
                  {icon?.type === 'raw' && <Fragment set:html={icon.html} />}
                </LinkButton>
              ),
            )}
          </div>
        )
      }
    </div>
    <LandingDiagram copy={diagramCopy} />
  </div>
</div>

<style>
  .hero-frame {
    container-type: inline-size;
  }
  /* The pitch above the diagram, or beside it on wide screens so both fit in
     the first viewport. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
    padding-block: 1rem 2.5rem;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    max-width: 42rem;
  }
  .copy > * {
    margin: 0;
  }
  .eyebrow {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .eyebrow:lang(ja) {
    letter-spacing: 0.04em;
    text-transform: none;
  }
  /* Roboto Mono ships 400 to 600, and 600 is the lightest weight at which
     Japanese fallback fonts use or synthesize a bold face. */
  h1 {
    color: var(--sl-color-white);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h1:lang(ja) {
    letter-spacing: 0;
    line-height: 1.4;
  }
  .tagline {
    max-width: 40rem;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  :is(h1, .tagline):lang(ja) {
    word-break: auto-phrase;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  @container (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: 3rem;
      padding-block: 1.5rem 3rem;
    }
    /* At this size, the 19 characters of "Google Calendar API" fit on one
       line of the 24rem column. */
    h1 {
      font-size: 2rem;
    }
  }

  /* Phones: the two buttons share the row, or stack when the labels need the
     room. */
  @container (max-width: 30rem) {
    .actions {
      align-self: stretch;
    }
    .actions > :global(.sl-link-button) {
      flex: 1 1 9.5rem;
      justify-content: center;
      white-space: nowrap;
    }
  }
</style>
