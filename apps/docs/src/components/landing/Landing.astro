---
/**
 * The documentation site's landing page body: a hero beside or above the
 * diagram, the case for a local server, capabilities, steps, and a closing
 * call to action. All text comes from `copy.<locale>.json`; this component
 * adds no prose of its own.
 * The page's only `<h1>` is the hero title, so the landing pages suppress
 * Starlight's page title (see `src/components/PageTitle.astro`).
 */
import en from './copy.en.json';
import ja from './copy.ja.json';
import LandingDiagram from './LandingDiagram.astro';

/** A locale the landing page is published in. */
type Locale = 'en' | 'ja';

interface Props {
  /** Selects the copy and the locale prefix of internal links. */
  locale: Locale;
}

const copies: Record<Locale, typeof en> = { en, ja };
const { locale } = Astro.props;
const copy = copies[locale];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localePrefix = locale === 'en' ? '' : `/${locale}`;
const quickStartHref = `${base}${localePrefix}/quick-start/`;
const repositoryHref = 'https://github.com/iktakahiro/calendarpit';
// Starlight's skip link targets the page title by this id, which the package
// does not export.
const pageTitleId = '_top';

// Stroke icons for the capability grid, in capability order: API, OAuth,
// fixtures and reset, watch webhooks, admin UI, and explicit errors.
const capabilityIcons = [
  'M6.5 5 3 10l3.5 5M13.5 5l3.5 5-3.5 5M11.25 4l-2.5 12',
  'M7.5 12.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm2.5-2.5h7.5M14.5 10v3M17 10v2',
  'M4 10a6 6 0 1 0 1.76-4.24L4 7.5M4 3.5v4h4M10 7v3.25l2 1.25',
  'M10 11.25a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5ZM6.82 13.18a4.5 4.5 0 0 1 0-6.36M13.18 6.82a4.5 4.5 0 0 1 0 6.36M4.34 15.66a8 8 0 0 1 0-11.32M15.66 4.34a8 8 0 0 1 0 11.32',
  'M3.5 4.5h13a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1ZM7.5 4.5v11M10 8h5M10 11h3.5',
  'M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14ZM5.05 5.05l9.9 9.9',
];
---

<div class='landing not-content'>
  <section class='hero'>
    <div class='hero-text'>
      <p class='eyebrow'>{copy.hero.eyebrow}</p>
      <h1 id={pageTitleId}>{copy.hero.title}</h1>
      <p class='tagline'>{copy.hero.tagline}</p>
      <div class='actions'>
        <a class='button primary' href={quickStartHref}>
          {copy.hero.primaryCta}
          <svg viewBox='0 0 16 16' aria-hidden='true' focusable='false'>
            <path d='M3 8h10M9 4l4 4-4 4' />
          </svg>
        </a>
        <a class='button secondary' href={repositoryHref}>
          <svg
            class='github'
            viewBox='0 0 16 16'
            aria-hidden='true'
            focusable='false'
          >
            <path
              d='M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z'
            />
          </svg>
          {copy.hero.secondaryCta}
        </a>
      </div>
    </div>
    <LandingDiagram copy={copy.diagram} />
  </section>

  <section class='section'>
    <h2>{copy.problem.title}</h2>
    <div class='compare'>
      <div class='case before'>
        <h3>{copy.problem.before.title}</h3>
        <ul>
          {
            copy.problem.before.items.map((item) => (
              <li>
                <svg viewBox='0 0 16 16' aria-hidden='true' focusable='false'>
                  <path d='M5 5l6 6M11 5l-6 6' />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class='case after'>
        <h3>{copy.problem.after.title}</h3>
        <ul>
          {
            copy.problem.after.items.map((item) => (
              <li>
                <svg viewBox='0 0 16 16' aria-hidden='true' focusable='false'>
                  <path d='M3.5 8.5l3 3 6-7' />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class='section'>
    <h2>{copy.capabilities.title}</h2>
    <ul class='capabilities'>
      {
        copy.capabilities.items.map((item, index) => (
          <li class='card'>
            <div class='card-head'>
              <span class='icon'>
                <svg viewBox='0 0 20 20' aria-hidden='true' focusable='false'>
                  <path d={capabilityIcons[index]} />
                </svg>
              </span>
              <h3>{item.title}</h3>
            </div>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class='section'>
    <h2>{copy.steps.title}</h2>
    <ol class='steps'>
      {
        copy.steps.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class='closing'>
    <div>
      <h2>{copy.closing.title}</h2>
      <p>{copy.closing.text}</p>
    </div>
    <a class='button primary' href={quickStartHref}>
      {copy.closing.cta}
      <svg viewBox='0 0 16 16' aria-hidden='true' focusable='false'>
        <path d='M3 8h10M9 4l4 4-4 4' />
      </svg>
    </a>
  </section>
</div>

<style>
  /* The admin UI's palette. Starlight's default theme is dark, and light
     mode sets `data-theme='light'` on the root element. */
  .landing {
    --lp-paper: #161719;
    --lp-rail: #1c1d20;
    --lp-surface: #1f2023;
    --lp-sunken: #191a1d;
    --lp-ink: #f1eee7;
    --lp-ink-2: #d1cfc8;
    --lp-muted: #b1b0a8;
    --lp-line: #333438;
    --lp-line-strong: #55565a;
    --lp-signal: #ff8d57;
    --lp-signal-ink: #ffac82;
    --lp-signal-wash: #412a21;
    --lp-signal-line: #7a4229;
    --lp-dot: rgb(241 238 231 / 0.07);
    --lp-shadow-lift: 0 12px 32px -12px rgb(0 0 0 / 0.65);
    --lp-button: #f1eee7;
    --lp-button-hover: #ffffff;
    --lp-button-ink: #161719;

    container: landing / inline-size;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding-block: 0 1.5rem;
    color: var(--lp-ink-2);
    counter-reset: section;
  }
  :global([data-theme='light']) .landing {
    --lp-paper: #f2f1ec;
    --lp-rail: #f8f7f3;
    --lp-surface: #fdfcfa;
    --lp-sunken: #f1efe9;
    --lp-ink: #16171a;
    --lp-ink-2: #393b3f;
    --lp-muted: #5d605a;
    --lp-line: #e2e0d8;
    --lp-line-strong: #cbc8be;
    --lp-signal: #e5531a;
    --lp-signal-ink: #ad3b0d;
    --lp-signal-wash: #fcece3;
    --lp-signal-line: #f1c3aa;
    --lp-dot: rgb(22 23 26 / 0.09);
    --lp-shadow-lift:
      0 1px 0 rgb(22 23 26 / 0.04), 0 12px 32px -12px rgb(22 23 26 / 0.22);
    --lp-button: #16171a;
    --lp-button-hover: #000000;
    --lp-button-ink: #f8f7f3;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol {
    margin: 0;
  }
  /* One weight for every heading: Roboto Mono ships 400 to 600, and 600 is
     the lightest weight at which Japanese fallback fonts use or synthesize
     a bold face, so Latin and Japanese glyphs match. */
  h1,
  h2,
  h3 {
    color: var(--lp-ink);
    font-weight: 600;
    text-wrap: balance;
  }
  .landing:lang(ja) :is(h1, h2, h3, .tagline) {
    word-break: auto-phrase;
  }
  h2 {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  h3 {
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .landing:lang(ja) :is(h2, h3) {
    letter-spacing: 0;
  }
  ul,
  ol {
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Hero: the pitch above the diagram, or beside it on wide screens so both
     fit in the first viewport. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    padding-top: 2rem;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    max-width: 42rem;
  }
  .eyebrow {
    color: var(--lp-signal-ink);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .landing:lang(ja) .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  h1 {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .landing:lang(ja) h1 {
    letter-spacing: 0;
    line-height: 1.4;
  }
  .tagline {
    max-width: 40rem;
    color: var(--lp-ink-2);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  /* Buttons, shaped like the admin UI's controls. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .button svg {
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .button svg.github {
    fill: currentColor;
    stroke: none;
  }
  .primary {
    background: var(--lp-button);
    color: var(--lp-button-ink);
  }
  .primary:hover {
    background: var(--lp-button-hover);
  }
  .secondary {
    border-color: var(--lp-line-strong);
    background: var(--lp-surface);
    color: var(--lp-ink);
  }
  .secondary:hover {
    border-color: var(--lp-muted);
  }
  .button:focus-visible {
    outline: 2px solid var(--lp-signal);
    outline-offset: 2px;
  }

  /* Sections open with an orange index above the heading. The index is
     decoration, so its alternative text is empty. */
  .section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    counter-increment: section;
  }
  .section > h2::before {
    content: counter(section, decimal-leading-zero) / '';
    display: block;
    margin-bottom: 0.375rem;
    color: var(--lp-signal-ink);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  /* Before and after: dashed for real Google, solid for Calendarpit, as in
     the diagram. */
  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem;
  }
  .case {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.125rem 1.25rem 1.25rem;
    border-radius: 10px;
  }
  .before {
    border: 1px dashed var(--lp-line-strong);
  }
  .after {
    border: 1px solid var(--lp-line);
    background: var(--lp-surface);
  }
  .case ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .case li {
    display: flex;
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .case li svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.2rem;
  }
  .before li {
    color: var(--lp-muted);
  }
  .after li {
    color: var(--lp-ink-2);
  }
  .after li svg {
    color: var(--lp-signal-ink);
    stroke-width: 1.75;
  }

  /* Capabilities: each card spans two rows of the grid and adopts them as a
     subgrid, so headings and body text line up across a row of cards. */
  .capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
  }
  .card {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0.625rem;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--lp-line);
    border-radius: 10px;
    background: var(--lp-surface);
  }
  .card-head {
    display: flex;
    gap: 0.625rem;
    align-items: center;
  }
  .card .icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--lp-line);
    border-radius: 6px;
    background: var(--lp-sunken);
    color: var(--lp-signal-ink);
  }
  .card .icon svg {
    width: 1rem;
    height: 1rem;
  }
  .card p {
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  /* Steps: numbered by a counter, joined by a hairline on wide screens. */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem 2rem;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.375rem;
    border: 1px solid var(--lp-line-strong);
    border-radius: 8px;
    background: var(--lp-surface);
    color: var(--lp-ink);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .steps li:first-child::before {
    border-color: var(--lp-signal);
    color: var(--lp-signal-ink);
  }
  .steps p {
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  /* Closing */
  .closing {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--lp-line);
    border-radius: 10px;
    background-color: var(--lp-paper);
    background-image: radial-gradient(var(--lp-dot) 0.8px, transparent 0.8px);
    background-size: 18px 18px;
  }
  .closing > div {
    display: flex;
    flex: 1 1 26rem;
    flex-direction: column;
    gap: 0.5rem;
  }
  .closing p {
    max-width: 44rem;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  @container landing (min-width: 50rem) {
    .steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1rem;
      left: 2.75rem;
      right: -1.25rem;
      border-top: 1px solid var(--lp-line-strong);
    }
  }

  @container landing (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: 3rem;
      padding-top: 1.5rem;
    }
    /* At this size, the 19 characters of "Google Calendar API" fit on one
       line of the 24rem column. */
    h1 {
      font-size: 2rem;
    }
  }

  @container landing (max-width: 49.99rem) {
    .hero {
      gap: 1.75rem;
      padding-top: 1rem;
    }
    .steps li {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.25rem 0.875rem;
    }
    .steps li::before {
      grid-row: 1 / span 2;
      margin-bottom: 0;
    }
    .steps h3 {
      padding-top: 0.3rem;
    }
    .closing {
      padding: 1.25rem;
    }
  }

  /* Phones: the two hero buttons share the row, or stack when the labels
     need the room. */
  @container landing (max-width: 30rem) {
    .actions {
      align-self: stretch;
    }
    .actions .button {
      flex: 1 1 9.5rem;
    }
    .closing .button {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 50rem) {
    .landing {
      gap: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>

<style is:global>
  /* The landing pages render their own <h1>, so Starlight's title panel is
     empty there; hide it and the rule above the content panel. */
  .content-panel:has(+ .content-panel .landing) {
    display: none;
  }
  .content-panel:has(.landing) {
    border-top: 0;
  }
  /* Edit link, last-updated date, and pagination are all off there, so the
     footer would only add empty space. */
  .sl-container:has(.landing) > footer {
    display: none;
  }
</style>
