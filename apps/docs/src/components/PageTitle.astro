---
/**
 * Starlight's page title, except on the landing page of each locale, which
 * renders its own `<h1>` in `landing/Landing.astro`.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { id, locale } = Astro.locals.starlightRoute;
// A locale's landing page has the locale itself as its route id; the root
// locale's is the empty string.
const isLanding = id === (locale ?? '');
---

{!isLanding && <Default />}
