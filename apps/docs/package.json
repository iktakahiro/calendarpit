{
  "name": "@calendarpit/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun scripts/clean.ts && bun --bun vite build && bun scripts/prepare-static.ts",
    "preview": "bun scripts/preview.ts",
    "deploy": "bun --bun wrangler deploy",
    "deploy:check": "bun --bun wrangler deploy --dry-run",
    "type-check": "bun check",
    "validate": "bun run build && bun run type-check && bun scripts/check-static.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@calendarpit/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
