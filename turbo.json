{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".bun-version", "bunfig.toml"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CALENDARPIT_CONFIG",
        "CALENDARPIT_WATCH_HOSTS",
        "CALENDARPIT_DATABASE"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
